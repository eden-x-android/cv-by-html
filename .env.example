# Copy to .env for `npm run dev:netlify`. On Netlify, set these under
# Site configuration → Environment variables.

# Fixed username typed on the login page
AUTH_USERNAME=
# Inbox that receives the OTP
AUTH_EMAIL=
# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=
# Sender address; without a verified domain Resend only allows onboarding@resend.dev
RESEND_FROM=CV Builder <onboarding@resend.dev>
# Signs session cookies and hashes OTPs — generate with: openssl rand -hex 32
SESSION_SECRET=
